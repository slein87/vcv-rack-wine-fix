+static void test_null_stream(void)
+{
+    wchar_t wbuf[16];
+    char buf[16];
+    size_t size;
+    void *ptr;
+    int ret;
+
+    /* msvcrt.dll validates the stream and fails with EINVAL, measured on Windows 11 */
+    errno = 0xdeadbeef;
+    size = fread(buf, 1, sizeof(buf), NULL);
+    ok(size == 0, "fread returned %Iu\n", size);
+    ok(errno == EINVAL, "fread: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    size = fwrite(buf, 1, sizeof(buf), NULL);
+    ok(size == 0, "fwrite returned %Iu\n", size);
+    ok(errno == EINVAL, "fwrite: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ptr = fgets(buf, sizeof(buf), NULL);
+    ok(!ptr, "fgets returned %p\n", ptr);
+    ok(errno == EINVAL, "fgets: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ptr = fgetws(wbuf, ARRAY_SIZE(wbuf), NULL);
+    ok(!ptr, "fgetws returned %p\n", ptr);
+    ok(errno == EINVAL, "fgetws: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ret = fputs("x", NULL);
+    ok(ret == EOF, "fputs returned %d\n", ret);
+    ok(errno == EINVAL, "fputs: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ret = fputws(L"x", NULL);
+    ok(ret == WEOF, "fputws returned %d\n", ret);
+    ok(errno == EINVAL, "fputws: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ret = fgetc(NULL);
+    ok(ret == EOF, "fgetc returned %d\n", ret);
+    ok(errno == EINVAL, "fgetc: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ret = fgetwc(NULL);
+    ok(ret == WEOF, "fgetwc returned %d\n", ret);
+    ok(errno == EINVAL, "fgetwc: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ret = _getw(NULL);
+    ok(ret == EOF, "_getw returned %d\n", ret);
+    ok(errno == EINVAL, "_getw: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ret = fputc('x', NULL);
+    ok(ret == EOF, "fputc returned %d\n", ret);
+    ok(errno == EINVAL, "fputc: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ret = fputwc(L'x', NULL);
+    ok(ret == WEOF, "fputwc returned %d\n", ret);
+    ok(errno == EINVAL, "fputwc: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ret = _putw(1, NULL);
+    ok(ret == EOF, "_putw returned %d\n", ret);
+    ok(errno == EINVAL, "_putw: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ret = ftell(NULL);
+    ok(ret == -1, "ftell returned %d\n", ret);
+    ok(errno == EINVAL, "ftell: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ret = fseek(NULL, 0, SEEK_SET);
+    ok(ret == -1, "fseek returned %d\n", ret);
+    ok(errno == EINVAL, "fseek: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ret = feof(NULL);
+    ok(ret == 0, "feof returned %d\n", ret);
+    ok(errno == EINVAL, "feof: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ret = ferror(NULL);
+    ok(ret == 0, "ferror returned %d\n", ret);
+    ok(errno == EINVAL, "ferror: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    ret = _fileno(NULL);
+    ok(ret == -1, "_fileno returned %d\n", ret);
+    ok(errno == EINVAL, "_fileno: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    rewind(NULL);
+    ok(errno == EINVAL, "rewind: errno = %d\n", errno);
+
+    errno = 0xdeadbeef;
+    clearerr(NULL);
+    ok(errno == EINVAL, "clearerr: errno = %d\n", errno);
+}
